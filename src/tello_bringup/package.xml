<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tello_bringup</name>
  <version>0.1.0</version>
  <description>Lab configuration, session and flight launch files, and recording for the Tello stack.</description>
  <maintainer email="mo@tello-twin.local">mo</maintainer>
  <license>MIT</license>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>tello_core</exec_depend>
  <exec_depend>tello_driver</exec_depend>
  <exec_depend>tello_mocap</exec_depend>
  <exec_depend>tello_flight</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rosbag2_py</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
