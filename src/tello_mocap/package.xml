<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tello_mocap</name>
  <version>0.1.0</version>
  <description>Vicon input for the Tello stack: mocap_adapter (validation, velocity) and mocap_sim (emulated Vicon).</description>
  <maintainer email="mo@tello-twin.local">mo</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tello_core</exec_depend>
  <exec_depend>tello_driver</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
